# Live-only runtime
ADCS_LLM_MODE=live
ADCS_LIVE_DB=adcs_live.sqlite3
ADCS_PORT=8001

# Exact models exposed in supervisor and institution-agent selectors.
ADCS_AVAILABLE_MODELS=deepseek:deepseek-v4-flash,deepseek:deepseek-v4-pro,anthropic:claude-haiku-4-5-20251001,anthropic:claude-sonnet-5,xai:grok-4.3,xai:grok-4.6
ADCS_DEFAULT_MODEL_ROTATION=deepseek:deepseek-v4-flash,anthropic:claude-haiku-4-5-20251001,xai:grok-4.3,deepseek:deepseek-v4-pro,anthropic:claude-sonnet-5,xai:grok-4.3,xai:grok-4.6

# Configure only providers you use. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=  # accepted compatibility alias
# XAI_API_KEY=     # preferred for Grok
# GROQ_API_KEY=    # accepted as an xAI compatibility alias in existing installs
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# A real Groq provider deployment should use GROQ_API_KEY only for groq:* models
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# OLLAMA_BASE=http://localhost:11434/v1

# Example multi-provider registry after adding keys:
# ADCS_AVAILABLE_MODELS=deepseek:deepseek-chat,openai:gpt-4.1-mini,anthropic:claude-sonnet-4-0,google:gemini-2.5-flash,mistral:mistral-small-latest,groq:llama-3.3-70b-versatile,ollama:llama3.1:8b
